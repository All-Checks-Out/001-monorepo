{
  "name": "@apps/core",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "vite build",
    "preview": "vite preview --port 4174",
    "deploy:local": "pnpm run generate-env && pnpm run build",
    "destroy:local": "echo \"No local core infrastructure to destroy.\"",
    "type-check": "tsc --noEmit && tsc --noEmit -p cdk/tsconfig.json",
    "package-cleanup": "rm -rf node_modules dist cdk.out",
    "dev": "bash ../../scripts/generate-ui-env.sh && vite --port 5174",
    "generate-env": "bash ../../scripts/generate-ui-env.sh",
    "upload": "AWS_PROFILE=management bash scripts/upload-route-app.sh",
    "invalidate-cloudfront": "AWS_PROFILE=management bash scripts/invalidate-route-app.sh",
    "deploy": "pnpm run generate-env && pnpm run build && pnpm run upload && pnpm run invalidate-cloudfront"
  },
  "dependencies": {
    "@frontend/app-ui": "workspace:*",
    "@frontend/api": "workspace:*",
    "@frontend/auth": "workspace:*",
    "@frontend/shadcn": "workspace:*",
    "@shared/permissions": "workspace:*",
    "@module-federation/bridge-react": "^2.6.0",
    "@module-federation/vite": "^1.16.11",
    "@tanstack/react-table": "^8.21.3",
    "lucide-react": "^0.575.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "7.13.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^25.3.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "aws-cdk-lib": "2.235.1",
    "constructs": "10.4.5",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "^7.3.1"
  }
}
