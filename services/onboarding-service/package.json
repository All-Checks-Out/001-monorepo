{
  "name": "@services/onboarding-service",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "type-check": "tsc --noEmit && tsc --noEmit -p cdk/tsconfig.json",
    "test": "vitest run",
    "database:show-secret": "tsx scripts/src/database-show-secret.ts",
    "test:security": "tsx scripts/src/onboarding-service-test.ts",
    "test:local-mode": "tsx scripts/src/local-mode-test.ts",
    "package-cleanup": "rm -rf node_modules cdk.out",
    "data:export": "tsx scripts/src/data-export.ts",
    "data:reset": "tsx scripts/src/data-reset.ts",
    "data:seed": "tsx scripts/src/data-seed.ts",
    "dev": "bash ../../scripts/run-backends.sh",
    "deploy": "cdk deploy onboarding-service-stack-$ACO24_STAGE --require-approval never --app \"tsx ./cdk/src/bin/onboarding.ts\" --context stage=$ACO24_STAGE && pnpm run database:migrate",
    "destroy": "cdk destroy onboarding-service-stack-$ACO24_STAGE --force --require-approval never --app \"tsx ./cdk/src/bin/onboarding.ts\" --context stage=$ACO24_STAGE",
    "database:migrate": "bash ../../scripts/update-database.sh",
    "database:reset": "bash ../../scripts/reset-database.sh"
  },
  "dependencies": {
    "@backend/events": "workspace:*",
    "@shared/permissions": "workspace:*",
    "aws-cdk-lib": "2.235.1",
    "constructs": "10.4.5",
    "@aws-sdk/client-eventbridge": "^3.1063.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1063.0",
    "@aws-sdk/client-secrets-manager": "^3.1063.0",
    "@aws-sdk/client-s3": "^3.1063.0",
    "@aws-sdk/client-ssm": "^3.1063.0",
    "@aws-sdk/s3-request-presigner": "^3.1063.0",
    "@codegenie/serverless-express": "^5.0.0",
    "express": "^5.2.1",
    "pg": "^8.16.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.161",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "@types/pg": "^8.15.6",
    "esbuild": "0.27.7",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "^4.1.9"
  }
}
